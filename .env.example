# Node does not automatically load this example. All values are placeholders.
LOCAL_DEMO_DB_ENABLED=false
MYSQL_SOCKET_PATH=/ABSOLUTE/PATH/TO/NEW/PRIVATE/mysql.sock
DB_USER=REPLACE_WITH_LOCAL_DEMO_USER
DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
DB_NAME=REPLACE_WITH_NEW_LOCAL_DEMO_SCHEMA
PORT=8443
LOCAL_DEMO_ORIGIN=https://127.0.0.1:8443
LOCAL_TLS_KEY_PATH=/ABSOLUTE/PRIVATE/PATH/server.key
LOCAL_TLS_CERT_PATH=/ABSOLUTE/PRIVATE/PATH/server.crt
